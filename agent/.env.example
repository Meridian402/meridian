# Meridian backend — environment reference.
#
# DOCUMENTATION ONLY. Per AGENTS.md, real values live in Railway (the fund
# manager's domain) and that is the only place they take effect. Never commit a
# real address, key, or token here — names, comments, and safe defaults only.
#
# Every variable the code reads is listed. Blank means "no default; the feature
# stays off until it is set". A value shown is the code's own default, repeated
# here so the effective setting is visible without reading the source.


# =============================================================================
# Chain + RPC
# =============================================================================
# Robinhood Chain RPC. READ endpoint (primary). Point this at a dedicated
# provider (Alchemy is Robinhood's recommended one) to escape the public RPC's
# rate limits. Public, rate-limited: https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URL=
# Optional explicit READ fallback, tried after the primary and before the public
# endpoint (which is always the final fallback). Reads fail over automatically.
ROBINHOOD_RPC_FALLBACK_URL=
# WRITE endpoint: transaction submission goes here, straight to the sequencer for
# the fewest hops to inclusion (the tx-speed edge). Leave blank to use the public
# sequencer-backed endpoint even when reads move to a dedicated provider. Only
# set this for a private/dedicated sequencer endpoint.
ROBINHOOD_WRITE_RPC_URL=
# Blockscout API used to reconstruct house-wallet capital flows for /api/performance.
MERIDIAN_EXPLORER_API=https://robinhoodchain.blockscout.com/api
# Legacy cross-chain bridge plumbing; unused by the Robinhood-only paths.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
WORMHOLE_RPC_URL=


# =============================================================================
# Autonomous execution + risk caps  ·  OPERATOR LEVERS (see AGENTS.md)
# =============================================================================
# Master switch for the autonomous LIQUIDITY engine: the LP guard (re-center,
# widen, withdraw, retile, collect on its 5-minute tick) and the cross-pool
# allocator. Boot-time gate — anything other than "on" leaves both loops
# unstarted, so a fresh deploy serves the API and moves no funds. Changing it
# requires a restart. An open LP position with the engine off is UNMANAGED:
# close positions before turning this off on the key-holding instance.
MERIDIAN_LP_ENGINE=
# Master kill-switch for autonomous DIRECTIONAL execution — the background loop
# only acts on its own enter_index/exit_index decisions when this is "true" AND a
# signer is configured below. Defaults off. Independent of MERIDIAN_LP_ENGINE
# above: neither switch gates the other, they are separate businesses.
#
# CAVEAT, so "trading off" is not misread as "nothing moves": with the LP engine
# on, the LP guard is position protection, not signal trading, and it runs even
# when this is false. It can re-center, widen, or withdraw an existing LP
# position on its own. For the engine to touch nothing at all, leave
# MERIDIAN_LP_ENGINE off.
AGENT_LIVE_TRADING=false
# Private key for the agent's own signing wallet. Generate one locally, fund it
# directly, and set it as a real environment variable on the host that runs the
# agent. Never commit this file with a real key in it, never paste a real key
# into a chat or ticket.
AGENT_SIGNER_PRIVATE_KEY=
# The wallet address for READ paths (portfolio, console, valuations) on
# deployments that carry NO private key — the public cloud instance sets this
# instead of AGENT_SIGNER_PRIVATE_KEY, so every balance and position read works
# while nothing on the box can sign. Ignored when a signer key is present.
MERIDIAN_WALLET_ADDRESS=
# Per-trade clamp and rolling-24h spend budget for the directional trade paths.
AGENT_MAX_TRADE_USD=1000
AGENT_MAX_DAILY_USD=5000
# GLOBAL runaway circuit breaker across ALL house-wallet money movement (LP mints
# and swaps, not just directional trades). Generous on purpose: it exists to halt
# a BUG looping money movement, not to budget normal activity. Tripping means
# "stop moving money, a human should look." Lower to tighten; do not raise
# casually. Getting OUT (withdrawals, collects, sells) is never breaker-blocked.
MERIDIAN_MAX_DAILY_WALLET_OPS=150
MERIDIAN_MAX_DAILY_NOTIONAL_USD=25000
# How often the background agent loop re-evaluates the strategy and logs a new
# "thought" (ms) — sets the cadence of the live monitor (GET /api/agent-thoughts).
AGENT_THINK_INTERVAL_MS=20000


# =============================================================================
# Momentum / rotation strategy (post-churn guards, 2026-07-13)
# =============================================================================
# Trailing lookback (minutes) the momentum signal is computed over. Was 15m; the
# churn incident showed 15-minute signals decay faster than the fees they incur.
AGENT_MOMENTUM_LOOKBACK_MINUTES=240
# Minimum leader-vs-laggard spread (percentage points) before a rotation fires.
# The BASE bar only; the strategy raises it per-pair by the cost multiple below.
AGENT_MIN_SPREAD_PCT=2
# The spread must hold above the bar continuously this long before a trade fires.
AGENT_SPREAD_PERSISTENCE_MINUTES=30
# At most one rotation per this window, measured from the durable executions
# ledger so a restart cannot forget.
AGENT_ROTATION_COOLDOWN_HOURS=24
# Required spread as a multiple of the pair's real round-trip pool fees.
AGENT_ROTATION_COST_MULTIPLE=3


# =============================================================================
# LP market-making engine
# =============================================================================
# AUTONOMOUS CAPITAL MOVEMENT — off by default. Set to 1 and the LP guard moves
# the book to the best-scoring pool on its own whenever the gain clears the
# cost-aware bar below. This is real money moving with no human in the loop.
MERIDIAN_AUTO_REBALANCE=
# The bar a move must clear: minimum expected gain, maximum payback period, and a
# hold-cooldown that prevents oscillation.
MERIDIAN_REBALANCE_MIN_GAIN_USD=2
MERIDIAN_REBALANCE_MAX_PAYBACK_DAYS=2
MERIDIAN_REBALANCE_COOLDOWN_HOURS=8
# Auto-recovery cap: if a retile fails or a weekend drift-pull leaves the wallet
# flat, the guard re-establishes the position on its own — but never deploys more
# than this without a human. THIS IS THE ANTI-RUNAWAY BOUND on unattended
# redeployment; above it, recovery defers to manual.
MERIDIAN_MAX_RECOVERY_USD=2000
# Sweep owed LP fees into the wallet once they clear this much (gas is negligible
# on this chain; position changes already collect).
MERIDIAN_COLLECT_THRESHOLD_USD=3
# Pool qualification: minimum depth for a discovered pool to become LP-viable,
# and how long the qualified set is cached. A pool must ALSO land a real mint
# before autonomous rebalancing will move into it (the landed-mint gate).
LP_QUALIFY_MIN_DEPTH_USD=2000
LP_QUALIFY_TTL_MS=1800000
# Scheduled deploy at the market open. Blank plan = disabled.
MERIDIAN_OPEN_DEPLOY_HOUR_UTC=14
MERIDIAN_OPEN_DEPLOY_PLAN=


# =============================================================================
# Auth + secrets
# =============================================================================
# Shared bearer for /mcp and the operator write routes. Gates the research
# pipeline write tool and the operator endpoints. It deliberately does NOT gate
# fund-moving tools — see MERIDIAN_EXECUTE_TOKEN. Unset => those routes answer
# loopback only (fail closed), never the open network.
MERIDIAN_MCP_TOKEN=
# SEPARATE, stricter secret for the fund-moving execute tools. It is NEVER
# embedded in any gateway MCP-server registration, so no hosted agent — house
# fleet or a user's chat agent — can execute trades via MCP even while holding
# the shared token above. Unset => fund-moving tools answer loopback only.
MERIDIAN_EXECUTE_TOKEN=
# HMAC key for wallet sign-in (SIWE) session bearers and challenge nonces.
# UNSET MEANS A RANDOM PER-BOOT SECRET: every redeploy silently signs out every
# user, and with more than one replica sign-in breaks outright, because a
# challenge issued by one replica cannot be verified by another. Set a strong
# random 32+ char value on any real deployment.
MERIDIAN_SESSION_SECRET=
# Per-IP HTTP rate limits. The global one must never throttle the live desk's
# legitimate polling (one active viewer runs ~300 req/min), only stop a flood.
# The auth limiter is strict: sign-in and signature verification are expensive.
GLOBAL_RATE_PER_MIN=1800
AUTH_RATE_PER_MIN=30
# Per-wallet chat guards: token-bucket rate limit, single-flight concurrency, and
# how long a queued turn waits for a slot before giving up.
CHAT_RATE_BURST=5
CHAT_RATE_REFILL_MS=3000
CHAT_MAX_CONCURRENT=40
CHAT_ACQUIRE_TIMEOUT_MS=15000


# =============================================================================
# x402 paywall (receiving side)
# =============================================================================
# Verification mode for incoming payments:
#   "self"  verify on-chain against Robinhood Chain (the real setting)
#   https…  a remote facilitator (not implemented yet — throws)
#   BLANK   STUB MODE: every payment proof is ACCEPTED WITHOUT VERIFICATION and
#           the revenue ledger records income that was never received. Local dev
#           only. Never leave this blank on a deployment that bills anyone.
X402_FACILITATOR_URL=
# Wallet Meridian's paid tools get paid into. Set the real address in Railway
# (see AGENTS.md — live config lives there, not in this template). Left blank,
# gated tools still 402 correctly but the payTo in the challenge is "unconfigured".
MERIDIAN_TREASURY_ADDRESS=
# Per-call prices in USD for the gated tools. A tool with no entry here is free.
PRICE_MARKET_DATA_USD=0.01
PRICE_SUGGEST_ROUTE_USD=0.05
PRICE_MARKET_UNIVERSE_USD=0.02
PRICE_BASIS_FEED_USD=0.10
PRICE_PERP_FEED_USD=0.05
PRICE_CARRY_QUOTE_USD=0.02
PRICE_LP_SCORE_USD=0.05
# Cross-chain routing fee, in basis points on trade notional, settled via x402
# from the trade's own wallet (payer) when meridian_bridge_execute runs.
BRIDGE_FEE_BPS=8


# =============================================================================
# MCP server (the layer an OpenHermit agent connects to)
# =============================================================================
MERIDIAN_MCP_HOST=127.0.0.1
MERIDIAN_MCP_PORT=8787
# URL the gateway uses to reach this server; only needed if it differs from
# host:port above (e.g. behind a reverse proxy or a different public hostname).
MERIDIAN_PUBLIC_MCP_URL=


# =============================================================================
# Earn surfaces (advise-then-approve; the user signs, Meridian holds no key)
# =============================================================================
# Slippage floor (bps) on user-signed syrupUSDG carry swaps; near-par stable
# pair, so keep this tight. Per-transaction USD cap on prepared carry swaps.
EARN_CARRY_SLIPPAGE_BPS=50
EARN_CARRY_MAX_USD=25000
# $INDEX yield entries: 6% slippage floor matches the house path's measured
# impact on this thin pool; funding leg (USDG->ETH bridge) gets a tight 1%.
# Per-transaction cap stays low because impact grows fast with size.
EARN_INDEX_SLIPPAGE_BPS=600
EARN_FUND_SLIPPAGE_BPS=100
EARN_INDEX_MAX_USD=1000
EARN_GAS_RESERVE_ETH=0.0003
# Deadline stamped on prepared swap calldata (seconds).
EARN_SWAP_DEADLINE_SEC=900
# Scout-to-earn: what one validated novel finding accrues, and the caps that
# bound the worst case (a sybil farm's daily take is the total, full stop).
# Settlement (POST /api/admin/settle-bounties) pays balances above the minimum
# in USDG from the house wallet; below it, settlement is skipped so dust never
# pays gas.
SCOUT_BOUNTY_USD=0.10
SCOUT_MAX_PER_WALLET_PER_DAY=3
SCOUT_MAX_DAILY_TOTAL_USD=5
SCOUT_MIN_PAYOUT_USD=0.50


# =============================================================================
# Auto-trading vaults (custody) — PREVIEW, off by default
# =============================================================================
# Set a strong random 32+ char CUSTODY_SESSION_MASTER to enable: it derives each
# user's scoped session key (never stored). Keep it secret and backed up — losing
# it loses the ability to drive existing vaults (funds stay safe; users still own
# their Safe).
CUSTODY_SESSION_MASTER=
CUSTODY_MAX_PER_TRADE_USD=100


# =============================================================================
# OpenHermit gateway + agent models
# =============================================================================
# Without GATEWAY_ADMIN_TOKEN set, fleet provisioning runs in dry-run mode (logs
# the plan only) and per-wallet agent creation degrades cleanly.
OPENHERMIT_GATEWAY_URL=http://127.0.0.1:4000
GATEWAY_ADMIN_TOKEN=
# Gateway user id that owns provisioned agents. Blank = the token's own user.
MERIDIAN_FLEET_OWNER_USER_ID=
# Model for each signed-in user's personal Merd chat agent.
MERIDIAN_USER_MODEL_PROVIDER=openrouter
MERIDIAN_USER_MODEL_ID=anthropic/claude-haiku-4.5
# Model for the house fleet agents.
MERIDIAN_FLEET_MODEL_PROVIDER=openrouter
MERIDIAN_FLEET_MODEL_ID=anthropic/claude-haiku-4.5
# Cheap model tier for the 12 RWA research agents. Extraction-style research
# doesn't need frontier reasoning; the trading agent is set separately above.
RWA_FLEET_MODEL_PROVIDER=anthropic
RWA_FLEET_MODEL_ID=claude-haiku-4-5
# Web-research provider wired into the research fleet.
RWA_FLEET_WEB_PROVIDER=exa


# =============================================================================
# Sampler loggers (opt-in background jobs; run on ONE instance only)
# =============================================================================
# These append to the durable ledgers the signals read. Running them on more than
# one replica double-writes the samples. Set to 1 to enable.
MERIDIAN_RUN_BASIS_LOGGER=
MERIDIAN_RUN_LIGHTER_LOGGER=
MERIDIAN_RUN_YIELD_LOGGER=
# Basis sampler cadence and log cap (lines, trimmed from the front).
BASIS_SAMPLE_MS=300000
BASIS_LOG_MAX_LINES=20000
# Lighter perp feed: API base and sampler cadence.
LIGHTER_API_BASE=https://api.rh.lighter.xyz
LIGHTER_SAMPLE_MS=1800000
# syrupUSDG / $INDEX yield sampler cadence.
YIELD_SAMPLE_MS=3600000


# =============================================================================
# Storage, caching, backup
# =============================================================================
# Durable data directory — the mounted volume in production. Every ledger,
# position registry, and guard-state file lives here. Falls back to the working
# directory when unset, which does NOT survive a redeploy.
MERIDIAN_DATA_DIR=
# Postgres mirror of the durable files (disaster recovery). Blank = no mirror.
DATABASE_URL=
MERIDIAN_BACKUP_INTERVAL_MS=300000
# Overrides for individual state files; default to paths under MERIDIAN_DATA_DIR.
MERIDIAN_POSITION_STATE_PATH=
MERIDIAN_UNIVERSE_PATH=
# Price cache. Set MERIDIAN_LIVE_PRICES=0 to freeze prices (tests/offline).
MERIDIAN_LIVE_PRICES=
MERIDIAN_PRICE_TTL_MS=180000
MERIDIAN_INDEX_YIELD_TTL_MS=120000


# =============================================================================
# Merd's X account (the autopilot's hands)
# =============================================================================
# OAuth 1.0a user-context credentials for @Meridian402. X_LIVE must be exactly
# "true" for anything to actually post; anything else is a dry run.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_LIVE=false
X_MAX_TWEET_CHARS=500
# Which gateway agent the launchd autopilot speaks through (owns the X voice
# and the <agent>-journal.jsonl continuity file).
MERD_X_AGENT_ID=copywriter


# =============================================================================
# Launchpad (user-facing token launches via the third-party Portal)
# =============================================================================
# WHICH CHAIN USER LAUNCHES LAND ON. Defaults to TESTNET when unset — every
# user-facing launch is a rehearsal until this is explicitly "mainnet". The
# agent persona discloses testnet mode at runtime, but the switch lives here.
LAUNCH_NETWORK=
# Optional commission receiver for the tax-style launch paths only; the persona
# is forbidden from steering users toward them.
LAUNCH_COMMISSION_RECEIVER=
