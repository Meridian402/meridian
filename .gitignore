# Dependencies
node_modules/
# Foundry: vendored deps and build output. forge-std is fetched by
# `forge install foundry-rs/forge-std`, not carried in the repo.
lib/
contracts/out/
cache/

# Build output
dist/
build/
.vercel/

# Secrets / local env — never commit real keys. Templates (.env.example) are kept.
.env
.env.*
!.env.example

# Runtime state — belongs on the host volume, not in version control. Also keeps
# operator/user wallet activity and the paid-tool ledger out of the repo.
*.jsonl
position-state.json

# Claude Code per-machine permission grants: operator config, not product code
.claude/settings.local.json

# OS / editor cruft
.DS_Store
*.log
*.tsbuildinfo
*.code-workspace

# Operator-only local scripts (leak local paths / not product code)
scripts-pushState.sh
_volprobe.mjs

# One-off probes and spikes. The agent/_* prefix is a MIXED namespace — the
# launchd-driven _merd-* jobs and the session-key spike are tracked product
# scripts — so the throwaways get their own directory instead of a prefix rule
# that would silently hide real work.
agent/scratch/

# launchd jobs are generated per-machine by agent/install-agents.sh, which fills
# in absolute paths. Committing them would leak local paths and go stale on a move.
agent/com.meridian.*.plist

# Frontend lives in its own private repo (meridian-frontend)
frontend/
agent/merd-memory/

# Merd's X mention cursor — runtime state, per-machine
agent/merd-engage-state.json

# Merd's outreach cursor — runtime state, per-machine
agent/merd-outreach-state.json
